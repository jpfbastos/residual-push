<mujoco model="panda push scene">
  <include file="panda_nohand_pusher.xml"/>

  <statistic center="0.45 0 0.1" extent="0.9"/>
  <option timestep="0.002" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.8 0.8 0.8 1"/>
  </asset>

  <!-- Frame convention: robot base (link0) at the world origin, table top at z = 0. -->
  <worldbody>
    <light pos="0.4 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 -0.8" material="groundplane"/>

    <geom name="table" type="box" size="0.6 0.6 0.4" pos="0.4 0 -0.4" material="table_mat"/>

    <body name="block" pos="0.5 0 0.025">
      <freejoint name="block_joint"/>
      <inertial pos="0 0 0" mass="0.2" diaginertia="0.0001017 0.0001017 0.00012"/>
      <geom name="block" type="box" size="0.03 0.03 0.025" rgba="0.9 0.4 0.2 1"/>
    </body>

    <!-- Goal marker: visual only (no collision). Move per-episode via model.site_pos. -->
    <body name="goal" mocap="true" pos="0.5 0.2 0.0005">
      <geom name="goal_marker"
        type="cylinder"
        size="0.005 0.0005"
        rgba="0.2 0.9 0.3 0.6"
        contype="0"
        conaffinity="0"/>
    </body>
  </worldbody>

  <!-- Explicit pairs override the default max-of-two friction rule.
       Randomise via model.pair_friction[pair_id, 0:2] (sliding) and [..., 2] (torsional). -->
  <contact>
    <pair name="block_table"  geom1="block" geom2="table"  condim="4" friction="0.5 0.5 0.005 0.0001 0.0001"/>
    <pair name="block_pusher" geom1="block" geom2="pusher" condim="3" friction="0.5 0.5 0.005 0.0001 0.0001"/>
  </contact>
</mujoco>